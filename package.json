{
  "name": "portfolio",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "ds": "pnpm --filter @portfolio/design-system",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r --if-present build",
    "contract:generate": "pnpm --filter @portfolio/api contract:generate && pnpm --filter @portfolio/contracts generate"
  }
}
