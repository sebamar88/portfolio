{
  "components": {
    "schemas": {
      "AddExpenseDto": {
        "properties": {
          "amount": {
            "description": "Decimal text in USD with at most 2 decimals.",
            "example": "12.50",
            "type": "string"
          },
          "description": {
            "description": "Trimmed; must not be blank.",
            "maxLength": 120,
            "type": "string"
          },
          "paidAt": {
            "description": "Day it was paid, as YYYY-MM-DD.",
            "example": "2026-05-20",
            "type": "string"
          },
          "participantIds": {
            "description": "Members who share the cost. Defaults to every member.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "payerId": {
            "type": "string"
          }
        },
        "required": [
          "description",
          "amount",
          "payerId",
          "paidAt"
        ],
        "type": "object"
      },
      "AddMemberDto": {
        "properties": {
          "memberId": {
            "type": "string"
          }
        },
        "required": [
          "memberId"
        ],
        "type": "object"
      },
      "BalancesResponse": {
        "properties": {
          "balances": {
            "description": "One entry per member, in the order they joined.",
            "items": {
              "$ref": "#/components/schemas/MemberBalanceResponse"
            },
            "type": "array"
          },
          "currency": {
            "enum": [
              "USD"
            ],
            "type": "string"
          }
        },
        "required": [
          "currency",
          "balances"
        ],
        "type": "object"
      },
      "CreateGroupDto": {
        "properties": {
          "name": {
            "description": "Trimmed; must not be blank.",
            "maxLength": 60,
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "example": "Bad Request",
            "type": "string"
          },
          "message": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            ]
          },
          "statusCode": {
            "example": 400,
            "type": "number"
          }
        },
        "required": [
          "statusCode",
          "error",
          "message"
        ],
        "type": "object"
      },
      "ExpensePageResponse": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/ExpenseResponse"
            },
            "type": "array"
          },
          "nextCursor": {
            "description": "Pass as `cursor` to get the next page; null on the last page.",
            "nullable": true,
            "type": "string"
          }
        },
        "required": [
          "items",
          "nextCursor"
        ],
        "type": "object"
      },
      "ExpenseResponse": {
        "properties": {
          "amount": {
            "description": "Cents.",
            "example": 1250,
            "type": "integer"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "currency": {
            "enum": [
              "USD"
            ],
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "groupId": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "paidAt": {
            "description": "YYYY-MM-DD.",
            "example": "2026-05-20",
            "type": "string"
          },
          "payerId": {
            "type": "string"
          },
          "shares": {
            "items": {
              "$ref": "#/components/schemas/ShareResponse"
            },
            "type": "array"
          }
        },
        "required": [
          "id",
          "groupId",
          "description",
          "amount",
          "currency",
          "payerId",
          "shares",
          "paidAt",
          "createdAt"
        ],
        "type": "object"
      },
      "GroupResponse": {
        "properties": {
          "id": {
            "type": "string"
          },
          "memberIds": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "memberIds"
        ],
        "type": "object"
      },
      "MemberBalanceResponse": {
        "properties": {
          "amount": {
            "description": "Cents. Positive: is owed money. Negative: owes money.",
            "type": "integer"
          },
          "memberId": {
            "type": "string"
          }
        },
        "required": [
          "memberId",
          "amount"
        ],
        "type": "object"
      },
      "SettlementsResponse": {
        "properties": {
          "currency": {
            "enum": [
              "USD"
            ],
            "type": "string"
          },
          "transfers": {
            "items": {
              "$ref": "#/components/schemas/TransferResponse"
            },
            "type": "array"
          }
        },
        "required": [
          "currency",
          "transfers"
        ],
        "type": "object"
      },
      "ShareResponse": {
        "properties": {
          "amount": {
            "description": "Cents.",
            "type": "integer"
          },
          "memberId": {
            "type": "string"
          }
        },
        "required": [
          "memberId",
          "amount"
        ],
        "type": "object"
      },
      "TransferResponse": {
        "properties": {
          "amount": {
            "description": "Cents, always more than 0.",
            "type": "integer"
          },
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          }
        },
        "required": [
          "from",
          "to",
          "amount"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "contact": {},
    "description": "",
    "title": "Shared Expenses API",
    "version": "0.1.0"
  },
  "openapi": "3.0.0",
